# Application
APP_NAME=Async Payment Processing Service
APP_ENV=local
LOG_LEVEL=INFO

# Static API authentication
# Replace in every non-local environment
API_KEY=change-me

# PostgreSQL
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments_password
DATABASE_URL=postgresql+asyncpg://payments:payments_password@postgres:5432/payments
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# RabbitMQ
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=rabbitmq_password
RABBITMQ_URL=amqp://payments:rabbitmq_password@rabbitmq:5672/

# Payment gateway emulator
PAYMENT_PROCESSING_MIN_DELAY_SECONDS=2.0
PAYMENT_PROCESSING_MAX_DELAY_SECONDS=5.0
PAYMENT_SUCCESS_RATE=0.90

# Consumer retry: three attempts total
PROCESSING_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_JITTER_RATIO=0.20

# Transactional outbox
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_CLAIM_TTL_SECONDS=120
OUTBOX_PUBLISH_CONCURRENCY=10
OUTBOX_MAX_RETRY_DELAY_SECONDS=60
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=5

# Webhook
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_SIGNING_SECRET=local-webhook-signing-secret-change-me-at-least-32-characters
WEBHOOK_REQUIRE_HTTPS=true

# JSON array. Private addresses remain prohibited except for these exact hosts
WEBHOOK_ALLOWED_PRIVATE_HOSTS=["mock-webhook"]

# Local mock webhook
# Set to 2 to demonstrate two retries followed by successful delivery
MOCK_WEBHOOK_FAILURES_BEFORE_SUCCESS=0
MOCK_WEBHOOK_FAILURE_STATUS=503
MOCK_WEBHOOK_SUCCESS_STATUS=204
MOCK_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300